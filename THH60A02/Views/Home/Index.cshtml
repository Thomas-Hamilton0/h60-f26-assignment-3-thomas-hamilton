@{
    ViewData["Title"] = "Home";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card mb-4">
            <div class="card-body">
                <h1 class="h4 mb-2">Heritage Reptile Supply</h1>
                <p class="text-muted mb-0">
                    Your one-stop shop for reptiles, habitats, heating, lighting, and reptile care supplies.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row">

    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Product Categories</h4>
                <p>View and manage reptile product categories.</p>

                <a asp-controller="ProductCategory" asp-action="Index" class="btn btn-primary">View Categories</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Products</h4>
                <p>View, create, edit, and manage store products.</p>

                <a asp-controller="Product" asp-action="Index" class="btn btn-primary">View Products</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>All Products by Category</h4>
                <p>Browse products grouped by category.</p>

                <a asp-controller="Product" asp-action="ProductsByCategory" class="btn btn-secondary">Open Report</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Products in Selected Category</h4>

                <p>View products for a selected category.</p>

                <a asp-controller="Product" asp-action="ProductsForCategory" class="btn btn-secondary">Open Report</a>
            </div>
        </div>
    </div>
</div>