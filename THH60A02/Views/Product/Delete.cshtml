@model Product

@{
    ViewData["Title"] = "Delete Product";
}

<h2>Delete Product</h2>

<p class="text-muted">Review the product information before permanently deleting it.</p>

<div class="alert alert-danger">This action cannot be undone</div>

<div asp-validation-summary="All" class="text-danger"></div>

<p>Are you sure you want to delete this product?</p>

<div class="mb-3">
    <label>Description</label>
    <input asp-for="Description" class="form-control" readonly />
</div>

<div class="mb-3">
    <label>Manufacturer</label>
    <input asp-for="Manufacturer" class="form-control" readonly />
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="ProductId" />

    <button type="submit" class="btn btn-danger">Delete</button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>