@model ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<h2>Create Product</h2>

<p class="text-muted"> Add a new product to the store inventory </p>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Manufacturer</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Stock</label>
        <input asp-for="Stock" class="form-control" />
    </div>

    @if (Model.CanManagePrices)
    {
        <div class="mb-3">
            <label>Buy Price</label>
            <input asp-for="BuyPrice" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Sell Price</label>
            <input asp-for="SellPrice" class="form-control" />
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Prices can only be set by a manager. This product will be created without prices.
        </div>
    }

    <div class="mb-3">
        <label>Category</label>

        <select asp-for="ProdCatId" class="form-control">
            @foreach (var category in Model.Categories)
            {
                <option value="@category.CategoryId">@category.ProdCat</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>

</form>