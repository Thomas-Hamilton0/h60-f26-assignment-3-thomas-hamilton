@model IEnumerable<ProductCategory>

@{
    ViewData["Title"] = "Product Categories";
}

<h2>Product Categories</h2>

<p class="text-muted"> Create, update, and organize product categories </p>

<form method="get" asp-action="Index" class="d-flex gap-2 mb-3" style="max-width: 420px;">
    <input type="search" name="search" value="@ViewData["Search"]" class="form-control"
           placeholder="Search categories" aria-label="Search categories" />
    <button type="submit" class="btn btn-primary">Search</button>
    @if (!string.IsNullOrWhiteSpace(ViewData["Search"]?.ToString()))
    {
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    }
</form>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create Category
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.ProdCat</td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-secondary">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>