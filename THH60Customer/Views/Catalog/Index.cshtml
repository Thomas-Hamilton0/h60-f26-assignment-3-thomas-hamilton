@model CatalogViewModel

@{
    ViewData["Title"] = "Catalog";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h1 class="h3 mb-1">Catalog</h1>
            <p class="text-muted mb-0">@Model.ProductCount product(s)</p>
        </div>

        <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-center w-100"
              style="max-width: 420px;" role="search">
            @if (Model.CategoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
            }
            <input type="search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Search products" aria-label="Search products" />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId"
                   class="btn btn-secondary">Clear</a>
            }
        </form>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (ViewData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@ViewData["Error"]</div>
    }

    <div class="mb-3 d-flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-search="@Model.Search"
           class="btn btn-sm @(Model.CategoryId == null ? "btn-primary" : "btn-outline-secondary")">
            All
        </a>
        @foreach (var category in Model.Categories)
        {
            <a asp-action="Index" asp-route-categoryId="@category.CategoryId" asp-route-search="@Model.Search"
               class="btn btn-sm @(Model.CategoryId == category.CategoryId ? "btn-primary" : "btn-outline-secondary")">
                @category.ProdCat
            </a>
        }
    </div>

    @if (Model.Products.Any())
    {
        <div class="row g-3">
            @foreach (var product in Model.Products)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5">@product.Description</h2>
                            <p class="text-muted mb-2">@product.Manufacturer</p>
                            <p class="mb-2">
                                <span class="badge bg-secondary">@product.CategoryName</span>
                            </p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <strong>
                                    @(product.SellPrice.HasValue
                                        ? $"${product.SellPrice.Value:0.00}"
                                        : "Price unavailable")
                                </strong>
                                @if (product.InStock)
                                {
                                    <span class="badge bg-success">In stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Out of stock</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@product.ProductId"
                               class="btn btn-primary flex-grow-1">Details</a>
                            <button type="button" class="btn btn-outline-secondary" disabled>
                                Add to cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No products found.</div>
    }
</div>
