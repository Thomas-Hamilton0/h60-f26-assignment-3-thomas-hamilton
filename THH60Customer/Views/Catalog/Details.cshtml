@model CustomerProduct

@{
    ViewData["Title"] = Model.Description;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index">Catalog</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Description</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-body">
            <h1 class="h3">@Model.Description</h1>
            <p class="text-muted">@Model.Manufacturer</p>

            <dl class="row">
                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.CategoryName</dd>

                <dt class="col-sm-3">Availability</dt>
                <dd class="col-sm-9">
                    @(Model.InStock ? $"{Model.Stock} in stock" : "Out of stock")
                </dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">
                    @(Model.SellPrice.HasValue
                        ? $"${Model.SellPrice.Value:0.00}"
                        : "Price unavailable")
                </dd>
            </dl>

            <p class="text-muted">
                Contact the store for more information about care and setup.
            </p>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" disabled>Add to cart</button>
                <a asp-action="Index" class="btn btn-secondary">Back to catalog</a>
            </div>
        </div>
    </div>
</div>
