@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>

<p class="text-muted">Manage customer records and their store sign-in accounts.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
}

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["Warning"]</div>
}

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@ViewData["Error"]</div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a asp-action="Create" class="btn btn-primary">Create Customer</a>

    <form method="get" asp-action="Index" class="d-flex gap-2" style="max-width: 420px;">
        <input type="search" name="search" value="@ViewData["Search"]" class="form-control"
               placeholder="Search customers" aria-label="Search customers" />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(ViewData["Search"]?.ToString()))
        {
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        }
    </form>
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Province</th>
            <th>Sign-in account</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-muted">No customers found.</td>
            </tr>
        }

        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.LastName, @customer.FirstName</td>
                <td>@customer.EmailAddress</td>
                <td>@customer.PhoneNumber</td>
                <td>@customer.Province</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(customer.IdentityUserId))
                    {
                        <span class="badge bg-success">Linked</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No account</span>
                    }
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@customer.CustomerId" class="btn btn-sm btn-outline-secondary">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
