@model UpdateStockViewModel

@{
    ViewData["Title"] = "Update Stock";
}

<h2>Update Stock</h2>

<p class="text-muted">Increase or decrease inventory quantities for a product.</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="UpdateStock" method="post">

    <input type="hidden" asp-for="ProductId" />

    <div class="mb-3">
        <label>Description</label>
        <input asp-for="Description" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Current Stock</label>
        <input asp-for="CurrentStock" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Stock Change</label>
        <input asp-for="StockChange" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Apply Change</button>

</form>